# -----------------------------------------------------------------------------
# RecruitBook Environment Configuration
# -----------------------------------------------------------------------------

# 1. Local Docker PostgreSQL (Default for docker-compose)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/recruitbook

# 2. Neon Serverless Postgres (Uncomment and replace with your credentials)
# DATABASE_URL=postgresql://neondb_owner:npg_password@ep-cold-mountain-123456.us-east-2.aws.neon.tech/recruitbook?sslmode=require

# 3. Supabase Postgres (Uncomment and replace with your credentials)
# Session / Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres
# Transaction Pooler (Port 6543 - recommended for Serverless / Next.js):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-supabase-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Application Settings
NEXT_PUBLIC_APP_NAME="RecruitBook"
NEXT_PUBLIC_ORG_NAME="My Organisation"
